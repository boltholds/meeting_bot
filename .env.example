API_KEY=change-me
MEETING_BOT_PORT=8080
DATA_DIR=/data
BOT_NAME=Super Transcriber Bot - идёт запись
RECORDING_NOTICE=Бот записывает аудио встречи для расшифровки. Продолжая участие, вы соглашаетесь с записью.

# Both APIs use API_KEY. Compose supplies the internal URL automatically.
SUPER_TRANSCRIBER_REF=31bf4a6f4ba4c186c91685473cf88d85e5cbc11f
SUPER_TRANSCRIBER_URL=http://super-transcriber:8000
SUPER_TRANSCRIBER_API_KEY=change-me
GOOGLE_STORAGE_STATE=
TRANSCRIPTION_LANGUAGE=ru
TRANSCRIPTION_ANALYZE=true
TRANSCRIPTION_MIN_SPEAKERS=1
TRANSCRIPTION_MAX_SPEAKERS=10

PULSE_SINK=meeting_output
FFMPEG_SEGMENT_SECONDS=300
JOIN_TIMEOUT_SECONDS=300

# Super Transcriber / WhisperX
HF_TOKEN=hf_your_token_here
WHISPERX_MODEL=small
WHISPERX_DEVICE=cuda
WHISPERX_COMPUTE_TYPE=float16
API_DATA_DIR=/data/api
API_MAX_UPLOAD_MB=1024

# Ollama runs on the Windows host, outside Docker.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=local
LLM_MODEL=qwen2.5:7b
